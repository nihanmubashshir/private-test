# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Legacy anon key on older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Legacy service_role key on older projects.
# Used by scripts/ only. Never import this under src/. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Display name, also used as the TOTP issuer.
NEXT_PUBLIC_APP_NAME=Personal Dashboard

# --- `pnpm db` target (migrations). Secrets: scripts/ only, never NEXT_PUBLIC_. ---
# Configure EITHER A or B. A is recommended: the CLI resolves a working connection itself,
# so it works on a machine without IPv6. B needs the session pooler URI for the same reason.

# A) Personal access token + project ref.
# Token: https://supabase.com/dashboard/account/tokens (starts sbp_)
# Ref:   the subdomain of your project URL, https://<ref>.supabase.co
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional; avoids being prompted for the database password on push.
SUPABASE_DB_PASSWORD=

# B) Direct connection string. Dashboard -> Project Settings -> Database -> Connection string
# -> URI, and pick the SESSION POOLER tab: db.<ref>.supabase.co is IPv6-only unless the project
# has the IPv4 add-on. Percent-encode special characters in the password (@ -> %40).
# Also required by `pnpm db verify`, which talks to Postgres directly.
SUPABASE_DB_URL=
