# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Legacy anon key on older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Legacy service_role key on older projects.
# Used by scripts/ only. Never import this under src/. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Display name, also used as the TOTP issuer.
NEXT_PUBLIC_APP_NAME=Personal Dashboard

# Postgres connection string for the target database, used by `pnpm db` only.
# Dashboard -> Project Settings -> Database -> Connection string -> URI (session pooler),
# with [YOUR-PASSWORD] replaced. Percent-encode special characters in the password (@ -> %40).
# This is a secret: scripts/ only, never imported under src/, never prefixed NEXT_PUBLIC_.
SUPABASE_DB_URL=
